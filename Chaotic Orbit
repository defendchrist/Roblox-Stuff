-- Simple Mouse-Target Orbiter Script
local config = {
    activationKey = Enum.KeyCode.E,
    
    -- Orbit speeds
    xSpeed = 3.0,
    ySpeed = 2.5,
    zSpeed = 3.5,
    
    -- Orbit radius
    radius = 8,
    
    -- Movement smoothness
    smoothness = 0.3
}

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Variables
local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local isOrbiting = false
local targetPlayer = nil
local elapsedTime = 0
local orbitConnection = nil
local originalWalkSpeed = humanoid.WalkSpeed

-- Find player under mouse cursor
local function getPlayerUnderMouse()
    local hit = mouse.Hit
    if not hit then return nil end
    
    local hitPosition = hit.Position
    local closestPlayer = nil
    local closestDistance = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - hitPosition).Magnitude
            if distance < closestDistance and distance < 50 then -- 50 stud search radius from mouse
                closestDistance = distance
                closestPlayer = player
            end
        end
    end
    
    return closestPlayer
end

-- Orbit update function
local function orbitUpdate(deltaTime)
    elapsedTime = elapsedTime + deltaTime
    
    -- Check if target is still valid
    if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        isOrbiting = false
        return
    end
    
    local targetPosition = targetPlayer.Character.HumanoidRootPart.Position
    
    -- Calculate orbit position
    local xOffset = math.sin(elapsedTime * config.xSpeed) * config.radius
    local yOffset = math.sin(elapsedTime * config.ySpeed * 0.7) * (config.radius * 0.5)
    local zOffset = math.cos(elapsedTime * config.zSpeed) * config.radius
    
    local orbitPosition = targetPosition + Vector3.new(xOffset, yOffset, zOffset)
    
    -- Smooth movement
    local currentPosition = humanoidRootPart.Position
    local newPosition = currentPosition:Lerp(orbitPosition, config.smoothness)
    
    -- Set position and look at target
    humanoidRootPart.CFrame = CFrame.lookAt(newPosition, targetPosition)
    
    -- Maintain emote-friendly state
    humanoid.PlatformStand = false
    humanoid.Sit = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- Toggle orbiting
local function toggleOrbit()
    if isOrbiting then
        -- Stop orbiting
        isOrbiting = false
        if orbitConnection then
            orbitConnection:Disconnect()
            orbitConnection = nil
        end
        
        -- Restore movement
        humanoid.WalkSpeed = originalWalkSpeed
        humanoid.JumpPower = 50
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
        
        print("Orbit stopped")
    else
        -- Start orbiting
        targetPlayer = getPlayerUnderMouse()
        if targetPlayer then
            isOrbiting = true
            elapsedTime = 0
            orbitConnection = RunService.Heartbeat:Connect(orbitUpdate)
            print("Orbiting: " .. targetPlayer.Name)
        else
            print("No player found under mouse")
        end
    end
end

-- Input handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == config.activationKey then
        toggleOrbit()
    end
end)

-- Character respawn handling
localPlayer.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    originalWalkSpeed = humanoid.WalkSpeed
    
    if isOrbiting then
        isOrbiting = false
        if orbitConnection then
            orbitConnection:Disconnect()
            orbitConnection = nil
        end
    end
end)

print("Simple Orbiter loaded! Hover mouse over a player and press E to orbit them")
